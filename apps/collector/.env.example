# Collector 采集服务环境变量（P1）
# 复制为 .env 后填入真实值

PORT=3004
TENANT_ID=00000000-0000-0000-0000-000000000000
DATABASE_URL=postgresql://pcb_user:dev_only_local@localhost:5432/pcb_leadgen
# scorer 地址：设置后采集完成会自动触发批量打分，新线索才会出现在 /api/lead-scores
SCORER_URL=http://localhost:3002

# ========== 搜索数据源 ==========
# brave            需注册，免费档 2000 次/月（https://api-dashboard.search.brave.com）
# duckduckgo       免费，无需 key，但需 VPN 直连 html.duckduckgo.com（国内不通）
# edgar            ✅ 免费，无需 key！SEC EDGAR 搜美国上市公司年报（含 SIC 行业标签）
# companies-house  ✅ 免费，需注册获取 API Key（https://developer.companyhouse.gov.uk/，500次/天）
# opencorporates   ✅ 免费，需注册获取 Token（https://opencorporates.com/api/keys，100次/天）
# tavily / serpapi 未实现
SEARCH_PROVIDER=edgar

# Brave Search API Key（仅 brave 时必填）
BRAVE_API_KEY=

# SEC EDGAR UA 标识（仅 edgar 时使用，格式：<公司名> <邮箱>，SEC 强制要求）
SEC_UA=PCBLeadGen contact@yourcompany.com

# Companies House UK API Key（https://developer.companyhouse.gov.uk/，500次/天免费档）
COMPANIES_HOUSE_API_KEY=

# OpenCorporates API Token（https://opencorporates.com/api/keys，100次/天免费档）
OPENCORPORATES_TOKEN=

# ========== 代理 IP 池（可选，Bright Data）==========
# 二选一：完整代理 URL 优先；否则由用户名 + token 拼装
BRIGHTDATA_PROXY_URL=
BRIGHTDATA_PROXY_USERNAME=
BRIGHTDATA_TOKEN=
BRIGHTDATA_PROXY_HOST=brd.superproxy.io
BRIGHTDATA_PROXY_PORT=33335

# ========== 合规与限流 ==========
# 同域名请求最小间隔（毫秒），合规下限 2000（≥2s），不可调低
COLLECTOR_MIN_INTERVAL_MS=2000
COLLECTOR_MAX_RETRIES=2
COLLECTOR_REQUEST_TIMEOUT_MS=20000
# 每关键词采集条数硬上限（服务端会把前端传入的更大值夹到该上限）；demo 小内存机器建议 3
COLLECTOR_MAX_RESULTS_PER_KEYWORD=10
# EDGAR 10-K enrich 并发数（每路整份缓冲年报并解析，1.8G 小内存服务器建议 2）
COLLECTOR_EDGAR_CONCURRENCY=3
COLLECTOR_ENRICH_ENABLED=true
COLLECTOR_SCORE_ENABLED=true
