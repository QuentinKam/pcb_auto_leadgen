# Collector 采集服务环境变量（P1）
# 复制为 .env 后填入真实值

PORT=3004
TENANT_ID=00000000-0000-0000-0000-000000000000
DATABASE_URL=postgresql://pcb_user:dev_only_local@localhost:5432/pcb_leadgen
# scorer 地址：设置后采集完成会自动触发批量打分，新线索才会出现在 /api/lead-scores
SCORER_URL=http://localhost:3002

# ========== 搜索数据源 ==========
SEARCH_PROVIDER=brave
# Brave Search API Key（https://api-dashboard.search.brave.com），免费额度约 1 req/s
BRAVE_API_KEY=

# ========== 代理 IP 池（可选，Bright Data）==========
# 二选一：完整代理 URL 优先；否则由用户名 + token 拼装
BRIGHTDATA_PROXY_URL=
BRIGHTDATA_PROXY_USERNAME=
BRIGHTDATA_TOKEN=
BRIGHTDATA_PROXY_HOST=brd.superproxy.io
BRIGHTDATA_PROXY_PORT=33335

# ========== 合规与限流 ==========
# 同域名请求最小间隔（毫秒），合规下限 2000（≥2s），不可调低
COLLECTOR_MIN_INTERVAL_MS=2000
COLLECTOR_MAX_RETRIES=2
COLLECTOR_REQUEST_TIMEOUT_MS=20000
COLLECTOR_MAX_RESULTS_PER_KEYWORD=10
COLLECTOR_ENRICH_ENABLED=true
COLLECTOR_SCORE_ENABLED=true
