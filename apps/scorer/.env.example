# Scorer 服务环境变量
DATABASE_URL=postgresql://pcb_user:dev_only_local@localhost:5432/pcb_leadgen
PORT=3002

# LLM（P2 内容生成必需）
# 二选一：Anthropic Claude 或 OpenAI 兼容（DeepSeek 等）
LLM_PROVIDER=openai_compatible  # anthropic | openai_compatible

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI 兼容（DeepSeek）
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com

# 品牌档案（P2 内容生成必需，开发信/私信中引用我方能力）
BRAND_COMPANY_NAME=Your PCB Manufacturing Co., Ltd.
BRAND_CAPABILITIES=4-32 layer PCB,HDI,Flexible PCB,PCBA one-stop
BRAND_CERTIFICATIONS=ISO9001,IATF16949,ISO13485
BRAND_LEAD_TIME=Prototype: 3-7 days, Mass production: 2-4 weeks
BRAND_INDUSTRIES=Industrial,Medical,Automotive,Consumer
