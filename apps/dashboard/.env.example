# Dashboard 前端环境变量
# 开发期：Vite proxy 转发 /api → http://localhost:3001，VITE_GATEWAY_URL 留空
# 生产期：填 gateway 的完整 URL，如 https://gateway.yourapp.com
VITE_GATEWAY_URL=
# 测试用 tenant_id（生产用 JWT 解析）
# 必须与 tenants 表中的租户一致（本地 Dev Tenant），否则看板全空 / 采集落库失败
VITE_TENANT_ID=d7ac80b9-a06d-4921-a70a-668a9c87ba93
# 测试用业务员 user_id（人工覆盖时作为 X-User-Id 发送，生产用 JWT 解析）
VITE_USER_ID=00000000-0000-0000-0000-000000000001
