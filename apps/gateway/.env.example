# Gateway 服务环境变量
# Postgres 连接（lead-scores/companies/tenants 直接查 DB；content 通过代理转发给 scorer）
DATABASE_URL=postgresql://pcb_user:dev_only_local@localhost:5432/pcb_leadgen
# 服务端口
PORT=3001
# 下游微服务地址（Gateway 在此做转发 + 超时 + 降级）
SCORER_URL=http://localhost:3002
MAILER_URL=http://localhost:3003
COLLECTOR_URL=http://localhost:3004

# ========== 鉴权 ==========
# off      — 放行所有请求，租户取 X-Tenant-Id 请求头（开发 / 8090 演示环境）
# required — 校验凭据；配置了 JWT_SECRET 时租户以 token 解析结果为准，请求头无法冒充
# 生产（8091）必须设为 required，不能只依赖 nginx basic auth
AUTH_MODE=off

# JWT 校验密钥（HMAC-SHA256）；设置后调用方需带 Authorization: Bearer <token>，
# token payload 需含 tenant_id 字段
# JWT_SECRET=your-jwt-secret

# 静态 API Key（未配置 JWT_SECRET 时的回退方案）；调用方需在 X-Api-Key 头中带上
# GATEWAY_API_KEY=your-gateway-api-key
