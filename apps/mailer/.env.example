# Mailer 邮件调度服务（P3）环境变量模板
# 复制为 .env 后填入真实值

# ========== 基础配置 ==========
# 服务端口（与 gateway .env.example MAILER_URL 对齐）
PORT=3003
# 租户 ID（本地开发用，生产从 JWT 解析）
TENANT_ID=00000000-0000-0000-0000-000000000000

# ========== 数据库 ==========
DATABASE_URL=postgresql://pcb_user:dev_only_local@localhost:5432/pcb_leadgen

# ========== Redis / BullMQ 队列 ==========
# Upstash 或自建 Redis，用于 BullMQ 发送队列 + 配额计数器
REDIS_URL=redis://localhost:6379/0

# ========== Resend 邮件发送 ==========
# Resend 官方 API Key（生产环境以 re_ 开头）
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Resend Webhook 签名密钥（在 Resend Dashboard → Webhooks → 添加后获得 whsec_xxx）
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========== 发件配置 ==========
# 默认发件域名（必须已在 Resend 验证通过，建议先 warmup 4-8 周再用）
DEFAULT_SENDING_DOMAIN=your-domain.com
# 默认发件邮箱（display name + address，例如 "Sales <sales@your-domain.com>"，可多个逗号分隔轮询）
DEFAULT_FROM_ADDRESSES="Sales Team <sales@your-domain.com>,BD Team <bd@your-domain.com>"
# 默认回复邮箱
DEFAULT_REPLY_TO=hello@your-domain.com
# 最小发送间隔（毫秒），防止触发反垃圾邮件规则，建议 500-2000
MIN_SEND_INTERVAL_MS=1000

# ========== 配额控制（域名/邮箱每日上限）==========
# 每域名每日最大发送量（warmup 期按 P3-3 计划表，生产期建议 ≤500）
MAX_DAILY_SENDS_PER_DOMAIN=500
# 每发件邮箱每日最大发送量（建议 ≤50）
MAX_DAILY_SENDS_PER_FROM_EMAIL=50

# ========== Unsubscribe（GDPR 合规）==========
# 退订链接基础 URL，最终会拼成 https://UNSUBSCRIBE_BASE_URL/unsubscribe?email=xxx&token=yyy
UNSUBSCRIBE_BASE_URL=https://your-domain.com
# 是否在每封邮件底部强制注入退订链接（GDPR 要求 MUST be true）
INJECT_UNSUBSCRIBE=true

# ========== 域名 warmup（P3-3）==========
# 是否启用 warmup（false 时不跑每日计划，但可手动 trigger 单次）
WARMUP_ENABLED=true
# warmup 起始日期（YYYY-MM-DD），用来算今日是第几天；不填默认今天
WARMUP_START_DATE=
# warmup 总周数（建议 8 周，最少 4 周，总周数决定增量计划表）
WARMUP_TOTAL_WEEKS=8
# 每日 warmup 触发 cron（默认 UTC 凌晨 2:00 = 国内 10:00，注意时区）
WARMUP_DAILY_CRON=0 2 * * *
# warmup 发送间隔（毫秒），warmup 建议稍慢 2-5s 更自然
WARMUP_SEND_INTERVAL_MS=3000
# warmup 种子邮箱列表（JSON 数组格式，100+ 自有真实邮箱最佳，可用 Mailtrap 测试）
# 例：["warm1@your-domain.com","warm2@your-domain.com"]
WARMUP_SEED_EMAILS=[]
# warmup 模拟交互：mock 模式下自动模拟 open（默认 75%）和 click（默认 35%）的比例
WARMUP_SIM_OPEN_RATE=0.75
WARMUP_SIM_CLICK_RATE=0.35
# 发送后模拟 open/click 的延迟区间（毫秒，真实用户行为越分散越好）
WARMUP_SIM_DELAY_MIN_MS=60000
WARMUP_SIM_DELAY_MAX_MS=900000

# ========== 监控告警 & 合规黑名单 ==========
# 投诉率阈值（小数，例如 0.001 = 0.1%，超过自动暂停该域名发送 7 天 + Redis key pcb:mailer:suspended:domain:<domain>）
COMPLAINT_RATE_THRESHOLD=0.001
# 软退信拉黑阈值（同一 contact 软退信累计 N 次后 contacts.active=false，永久拉黑）
SOFT_BOUNCE_BLACKLIST_THRESHOLD=3
# Sentry DSN（可选）
SENTRY_DSN=
