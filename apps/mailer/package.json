{
  "name": "@pcb/mailer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "worker": "bun run --hot src/workers/send-worker.ts",
    "build": "bun build src/index.ts src/workers/send-worker.ts --target bun --outdir dist",
    "start": "bun run dist/index.js",
    "start:worker": "bun run dist/send-worker.js",
    "test": "bun test"
  },
  "dependencies": {
    "@pcb/db": "workspace:*",
    "@pcb/queue": "workspace:*",
    "@pcb/types": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "dotenv": "^16.4.5",
    "hono": "^4.13.7",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "resend": "^4.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.23.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
